# ============================================================================
# Eternal Paws Digital Media Platform - Production Environment Variables
# Copy to .env.local for local deployment or set in Vercel Project Settings
# ============================================================================

# 1. Supabase PostgreSQL & Cloud Storage
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Universal AI Editorial Studio (TokenRouter / DeepSeek v4 / Qwen / OpenAI)
AI_API_BASE_URL=https://api.tokenrouter.ai/v1
AI_API_KEY=your_tokenrouter_or_openai_api_key_here
AI_MODEL_NAME=deepseek/deepseek-chat

# 3. Transactional Email Dispatcher (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
NEWSLETTER_FROM_EMAIL=pack@eternal-paws.com

# 4. Super Admin Governance
ADMIN_DEFAULT_EMAIL=pawsluvshop@gmail.com
ADMIN_DEFAULT_PASSWORD=admin123
ADMIN_JWT_SECRET=super-secret-jwt-key-replace-in-production-64chars

# 5. Inactivity Keep-Alive Cron Security
CRON_SECRET=your-random-cron-secret-key

# 6. Canonical Domain URL
NEXT_PUBLIC_SITE_URL=https://eternal-paws.com
