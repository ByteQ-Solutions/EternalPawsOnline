# Eternal Paws Platform Environment Configuration
# Copy this file to .env.local for development

# Database / Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email Provider (Resend / Mailchimp)
RESEND_API_KEY=re_your_api_key_here
NEWSLETTER_FROM_EMAIL=pack@eternal-paws.org

# Admin Security & Auth
ADMIN_JWT_SECRET=super-secret-jwt-key-replace-in-production
ADMIN_DEFAULT_EMAIL=editor@eternal-paws.org
ADMIN_DEFAULT_PASSWORD=ChangeThisStrongPass123!

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://eternal-paws.org
